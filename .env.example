# ============================================
# Lisan - Application Configuration
# Copy this file to .env and fill in your values
# ============================================

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_DEBUG=true
FLASK_PORT=5018

# ============================================
# AI Provider API Keys
# ============================================

# OpenRouter (Primary - Advanced)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-3.1-pro-preview
OPENROUTER_FALLBACK_MODEL=qwen/qwen3-coder:free
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (Secondary - Standard)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (Fallback - Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ============================================
# Application Settings
# ============================================

# AI request timeout in seconds
AI_TIMEOUT=30

# Rate limiting
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_CHAT=20/minute

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# ============================================
# Google OAuth (Optional)
# ============================================
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# ============================================
# SMTP Email Verification (Optional)
# ============================================
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password

# ============================================
# Telegram Bot - Credit Purchase Notifications (Optional)
# ============================================
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_ADMIN_CHAT_ID=your-chat-id

# ============================================
# Admin Account
# ============================================
# ADMIN_EMAIL=admin@example.com
