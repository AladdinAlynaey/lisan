# ============================================
# Lisan - Application Configuration
# ============================================

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_DEBUG=true
FLASK_PORT=5018

# ============================================
# AI Provider API Keys
# ============================================

# OpenRouter (Primary - Advanced)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash-preview
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-preview
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (Secondary - Standard)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (Fallback - Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=model_name

# ============================================
# Application Settings
# ============================================

# AI request timeout in seconds
AI_TIMEOUT=30

# Rate limiting
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_CHAT=20/minute

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10
